# Agent Configuration
HERMES_SERVER_ID=srv_your_server_id
HERMES_API_KEY=your_api_key_from_backend
HERMES_BACKEND_URL=http://localhost:3000/api/v1

# Scan interval (cron format)
# "0 * * * *" = every hour
# "*/30 * * * *" = every 30 minutes
HERMES_SCAN_INTERVAL=0 * * * *

# Mount paths to monitor (comma-separated)
HERMES_MOUNT_PATHS=/,/var,/home
